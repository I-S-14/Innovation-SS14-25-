<BoxContainer
    xmlns="https://spacestation14.io"
    Orientation="Vertical"
    HorizontalExpand="True"
    Margin="0 0 0 8">

    <!--
        The root stays visible and only its contents are toggled. Robust does not tick
        FrameUpdate on a hidden control, so a panel that hides itself can never decide to come
        back — which is exactly how this one vanished.
    -->
    <BoxContainer Name="Content" Orientation="Vertical" HorizontalExpand="True" Visible="False">
        <BoxContainer Name="DiagnosisList" Orientation="Vertical" HorizontalExpand="True" />
    </BoxContainer>
</BoxContainer>
