<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client._IS14.Economy.EconomyMonitor"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'economy-monitor-window-title'}"
               Resizable="True"
               SetSize="1100 640"
               MinSize="800 480">
    <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">

        <!-- ── Left: map + vendor list ── -->
        <BoxContainer Orientation="Vertical" SetWidth="380" Margin="4 4 2 4">

            <ui:EconomyMonitorNavMapControl Name="NavMap"
                                            VerticalExpand="True"
                                            HorizontalExpand="True"
                                            MinHeight="260"
                                            Margin="0 0 0 4"/>

            <Label Text="{Loc 'economy-monitor-vendors-label'}"
                   FontColorOverride="#8AACCC"
                   Margin="2 4 2 2"/>

            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" MinHeight="100">
                <BoxContainer Name="VendorList" Orientation="Vertical" HorizontalExpand="True"/>
            </ScrollContainer>

        </BoxContainer>

        <!-- ── Divider ── -->
        <PanelContainer StyleClasses="LowDivider" SetWidth="1" VerticalExpand="True"/>

        <!-- ── Right: search + log ── -->
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="2 4 4 4">

            <!-- Search row -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <Label Text="{Loc 'economy-monitor-search-account'}"
                       FontColorOverride="#8AACCC"
                       VerticalAlignment="Center"
                       Margin="0 0 6 0"/>
                <LineEdit Name="AccountSearch"
                          HorizontalExpand="True"
                          PlaceHolder="{Loc 'economy-monitor-search-placeholder'}"/>
                <Button Name="ClearBtn" Text="✕" SetWidth="30" Margin="4 0 0 0"/>
            </BoxContainer>

            <!-- Log header -->
            <BoxContainer Name="LogHeader" Orientation="Horizontal" Margin="0 0 0 2">
                <Label Text="{Loc 'economy-monitor-col-time'}"
                       FontColorOverride="#8AACCC" SetWidth="80" Margin="4 2"/>
                <Label Text="{Loc 'economy-monitor-col-account'}"
                       FontColorOverride="#8AACCC" SetWidth="70" Margin="4 2"/>
                <Label Text="{Loc 'economy-monitor-col-amount'}"
                       FontColorOverride="#8AACCC" SetWidth="80" Margin="4 2"/>
                <Label Text="{Loc 'economy-monitor-col-description'}"
                       FontColorOverride="#8AACCC" HorizontalExpand="True" Margin="4 2"/>
                <Label Text="{Loc 'economy-monitor-col-balance'}"
                       FontColorOverride="#8AACCC" SetWidth="80" Margin="4 2"/>
                <Label Text="" SetWidth="24" Margin="4 2"/>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 2"/>

            <!-- Log rows (populated from code) -->
            <ScrollContainer Name="LogScroller" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="LogRows" Orientation="Vertical" HorizontalExpand="True"/>
            </ScrollContainer>

        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
