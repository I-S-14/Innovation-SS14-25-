<is14:CyborgHudGui
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:is14="clr-namespace:Content.Client._IS14.Cyborgs.UI"
    xmlns:inventory="clr-namespace:Content.Client.UserInterface.Systems.Inventory.Controls"
    Orientation="Vertical"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Margin="0 0 0 4">

    <!-- Every built-in tool, opened with the model button. -->
    <PanelContainer Name="ToolsPanel"
                    Visible="False"
                    HorizontalAlignment="Center"
                    Margin="0 0 0 6">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#14181DE8"
                              BorderColor="#3E5A3E"
                              BorderThickness="2" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="8 6" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                <Label Name="ModelLabel" StyleClasses="LabelHeading" HorizontalExpand="True" />
                <Label Name="HintLabel"
                       Text="{Loc 'cyborg-hud-tools-hint'}"
                       StyleClasses="LabelSubText"
                       VerticalAlignment="Center" />
            </BoxContainer>
            <GridContainer Name="ToolGrid"
                           Columns="8"
                           HSeparationOverride="2"
                           VSeparationOverride="2" />
        </BoxContainer>
    </PanelContainer>

    <!-- tgstation's bottom bar: model, three slots, store. -->
    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="2">
        <inventory:ItemStatusPanel Name="StatusPanel"
                                   SetWidth="125"
                                   SetHeight="60"
                                   VerticalAlignment="Bottom"
                                   Margin="0 0 6 2" />
        <is14:CyborgHudSlot Name="ModelButton" ToolTip="{Loc 'cyborg-hud-model-tooltip'}" />
        <BoxContainer Name="SlotRow" Orientation="Horizontal" SeparationOverride="2" Margin="6 0" />
        <is14:CyborgHudSlot Name="StoreButton" ToolTip="{Loc 'cyborg-hud-store-tooltip'}" />
        <is14:CyborgHudSlot Name="LampButton" ToolTip="{Loc 'cyborg-hud-lamp-tooltip'}" Margin="6 0 0 0" />
    </BoxContainer>
</is14:CyborgHudGui>
