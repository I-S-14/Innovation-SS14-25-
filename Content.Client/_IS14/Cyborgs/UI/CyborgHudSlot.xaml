<is14:CyborgHudSlot
    xmlns="https://spacestation14.io"
    xmlns:is14="clr-namespace:Content.Client._IS14.Cyborgs.UI"
    xmlns:cooldown="clr-namespace:Content.Client.Cooldown"
    SetSize="64 64"
    MouseFilter="Stop">

    <TextureRect Name="Background"
                 Stretch="Scale"
                 HorizontalExpand="True"
                 VerticalExpand="True" />
    <SpriteView Name="ItemView"
                Scale="2 2"
                SetSize="64 64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
    <!-- Fill gauge of the held tool, drawn on the slot only. -->
    <TextureRect Name="Gauge"
                 Stretch="Scale"
                 SetSize="64 64"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visible="False" />
    <!-- Crossed circle over an offline slot, the upstream blocked hand texture. -->
    <TextureRect Name="BlockedRect"
                 TextureScale="2 2"
                 Stretch="KeepCentered"
                 HorizontalExpand="True"
                 VerticalExpand="True"
                 Visible="False" />
    <!-- Use delay sweep, like the upstream hand buttons. -->
    <cooldown:CooldownGraphic Name="CooldownDisplay" Visible="False" />
</is14:CyborgHudSlot>
