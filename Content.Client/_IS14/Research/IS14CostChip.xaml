<is14:IS14CostChip
    xmlns="https://spacestation14.io"
    xmlns:is14="clr-namespace:Content.Client._IS14.Research"
    VerticalAlignment="Center"
    Margin="0 0 5 0">

    <PanelContainer Name="ChipPanel">
        <BoxContainer Orientation="Horizontal" Margin="4 1">
            <Label Name="AmountLabel" StyleClasses="LabelSmall" VerticalAlignment="Center" />
            <TextureRect Name="IconRect"
                         MinSize="14 14"
                         Stretch="KeepAspectCentered"
                         VerticalAlignment="Center"
                         Margin="3 0 0 0" />
        </BoxContainer>
    </PanelContainer>

</is14:IS14CostChip>
