<apps:TasksAppFragment xmlns="https://spacestation14.io"
                       xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                       xmlns:controls="clr-namespace:Content.Client._IS14.Controls">
    <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
        <LineEdit Name="AddEdit" HorizontalExpand="True" Margin="0 0 3 0" />
        <controls:IconTile Name="AddButton" Compact="True" IconSize="14" />
    </BoxContainer>

    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Name="TaskList" Orientation="Vertical" HorizontalExpand="True" />
    </ScrollContainer>

    <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
        <Label Name="CountLabel" VerticalAlignment="Center" />
        <Control HorizontalExpand="True" />
        <controls:IconTile Name="ClearButton" Compact="True" IconSize="12" />
    </BoxContainer>
</apps:TasksAppFragment>
