<apps:FilesAppFragment xmlns="https://spacestation14.io"
                       xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                       xmlns:controls="clr-namespace:Content.Client._IS14.Controls">
    <PanelContainer Name="MemoryPanel" HorizontalExpand="True" Margin="0 0 0 6">
        <BoxContainer Orientation="Vertical" Margin="6 4">
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <TextureRect Name="MemoryIcon" SetSize="14 14" Stretch="KeepAspectCentered"
                             VerticalAlignment="Center" Margin="0 0 5 0" />
                <Label Name="MemoryCaption" VerticalAlignment="Center" />
                <Control HorizontalExpand="True" />
                <Label Name="MemoryValue" VerticalAlignment="Center" />
            </BoxContainer>
            <controls:ThresholdBar Name="MemoryBar" MinHeight="10" ShowTicks="True" />
            <BoxContainer Orientation="Horizontal" Margin="0 3 0 0">
                <Label Name="MemoryBreakdown" VerticalAlignment="Center" />
                <Control HorizontalExpand="True" />
                <Label Name="MemoryFree" VerticalAlignment="Center" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Name="AppList" Orientation="Vertical" HorizontalExpand="True" />
    </ScrollContainer>
</apps:FilesAppFragment>
