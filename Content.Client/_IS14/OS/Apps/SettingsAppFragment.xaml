<apps:SettingsAppFragment xmlns="https://spacestation14.io"
                          xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                          xmlns:controls="clr-namespace:Content.Client._IS14.Controls">
    <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
        <TextureRect Name="ThemeIcon" SetSize="14 14" Stretch="KeepAspectCentered"
                     VerticalAlignment="Center" Margin="0 0 5 0" />
        <Label Name="ThemeCaption" VerticalAlignment="Center" />
    </BoxContainer>
    <controls:ChoiceStrip Name="ThemeStrip" HorizontalExpand="True" Margin="0 0 0 8" />
    <BoxContainer Name="ActionList" Orientation="Vertical" HorizontalExpand="True" />
    <Control VerticalExpand="True" />
    <controls:StatRow Name="AboutRow" />
</apps:SettingsAppFragment>
