<apps:OrdersAppFragment xmlns="https://spacestation14.io"
                        xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                        xmlns:controls="clr-namespace:Content.Client._IS14.Controls">
    <controls:StatRow Name="StationRow" Framed="True" Margin="0 0 0 4" />
    <controls:ChoiceStrip Name="Sections" Orientation="Horizontal" Margin="0 0 0 4" />
    <LineEdit Name="SearchEdit" HorizontalExpand="True" Margin="0 0 0 4" />

    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Name="EntryList" Orientation="Vertical" HorizontalExpand="True" />
    </ScrollContainer>

    <!-- Order form for the product picked out of the catalogue. Lives outside the list, which
         is rebuilt on every state push and would take a half-typed amount down with it. -->
    <PanelContainer Name="OrderPanel" HorizontalExpand="True" Margin="0 4 0 0" Visible="False">
        <BoxContainer Orientation="Vertical" Margin="5 4">
            <Label Name="OrderTitle" Margin="0 0 0 3" />
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <LineEdit Name="AmountEdit" HorizontalExpand="True" Margin="0 0 3 0" />
                <controls:IconTile Name="ConfirmButton" Compact="True" IconSize="12" Margin="0 0 3 0" />
                <controls:IconTile Name="CancelButton" Compact="True" IconSize="12" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</apps:OrdersAppFragment>
