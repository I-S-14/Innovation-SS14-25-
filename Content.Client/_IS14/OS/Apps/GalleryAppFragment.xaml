<apps:GalleryAppFragment xmlns="https://spacestation14.io"
                        xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                        xmlns:controls="clr-namespace:Content.Client._IS14.Controls">
    <!-- Contact sheet. -->
    <BoxContainer Name="GridBox" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
            <Label Name="CountLabel" HorizontalExpand="True" VerticalAlignment="Center" />
            <Label Name="MemoryLabel" VerticalAlignment="Center" />
        </BoxContainer>
        <ScrollContainer Name="GridScroll" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="GridBody" Orientation="Vertical" HorizontalExpand="True">
                <Label Name="EmptyLabel" Visible="False" />
                <GridContainer Name="Grid" Columns="3" HorizontalExpand="True" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>

    <!-- One photo, full size. Takes the whole app: that is what a gallery is for. -->
    <BoxContainer Name="ViewBox" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                  Visible="False">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
            <controls:IconTile Name="BackButton" Compact="True" IconSize="12" Margin="0 0 3 0" />
            <Label Name="TitleLabel" HorizontalExpand="True" VerticalAlignment="Center" ClipText="True" />
            <controls:IconTile Name="DeleteButton" Compact="True" IconSize="12" />
        </BoxContainer>
        <PanelContainer Name="ViewPanel" HorizontalExpand="True" VerticalExpand="True">
            <TextureRect Name="FullImage" Stretch="KeepAspectCentered" Margin="4"
                         HorizontalExpand="True" VerticalExpand="True" />
        </PanelContainer>
        <Label Name="MetaLabel" Margin="0 3 0 0" />
    </BoxContainer>
</apps:GalleryAppFragment>
