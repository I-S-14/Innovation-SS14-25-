<apps:MessengerAppFragment xmlns="https://spacestation14.io"
                           xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                           xmlns:controls="clr-namespace:Content.Client._IS14.Controls">

    <!-- Header: own number, plus the contacts/mute switches. -->
    <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
        <controls:IconTile Name="BackButton" Compact="True" IconSize="12" Margin="0 0 3 0" Visible="False" />
        <Label Name="HeaderLabel" HorizontalExpand="True" VerticalAlignment="Center" ClipText="True" />
        <controls:IconTile Name="DirectoryButton" Compact="True" IconSize="12" Margin="0 0 3 0" />
        <controls:IconTile Name="MuteButton" Compact="True" IconSize="12" />
    </BoxContainer>

    <Label Name="ErrorLabel" Margin="0 0 0 3" Visible="False" />

    <ScrollContainer Name="ListScroll" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Name="EntryList" Orientation="Vertical" HorizontalExpand="True" />
    </ScrollContainer>

    <!-- Conversation view. -->
    <BoxContainer Name="ChatBox" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Visible="False">
        <ScrollContainer Name="MessageScroll" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="MessageList" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>
        <PanelContainer Name="AttachPanel" HorizontalExpand="True" Margin="0 3 0 0" Visible="False">
            <BoxContainer Orientation="Horizontal" Margin="4 2">
                <Label Name="AttachLabel" HorizontalExpand="True" VerticalAlignment="Center" ClipText="True" />
                <controls:IconTile Name="AttachClearButton" Compact="True" IconSize="10" />
            </BoxContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
            <controls:IconTile Name="AttachButton" Compact="True" IconSize="12" Margin="0 0 3 0" />
            <LineEdit Name="MessageEdit" HorizontalExpand="True" />
            <controls:IconTile Name="SendButton" Compact="True" IconSize="12" Margin="3 0 0 0" />
        </BoxContainer>
    </BoxContainer>
</apps:MessengerAppFragment>
