<apps:NotesAppFragment xmlns="https://spacestation14.io"
                       xmlns:apps="clr-namespace:Content.Client._IS14.OS.Apps"
                       xmlns:controls="clr-namespace:Content.Client._IS14.Controls">
    <PanelContainer Name="EditPanel" HorizontalExpand="True" VerticalExpand="True">
        <TextEdit Name="NoteEdit" HorizontalExpand="True" VerticalExpand="True" />
    </PanelContainer>
    <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
        <Label Name="SavedLabel" HorizontalExpand="True" VerticalAlignment="Center" />
        <controls:IconTile Name="ExportButton" Compact="True" IconSize="14" Margin="0 0 3 0" />
        <controls:IconTile Name="SaveButton" Compact="True" IconSize="14" MinWidth="100" />
    </BoxContainer>
</apps:NotesAppFragment>
